# Line endings are decided by this file instead of by each machine's
# core.autocrlf setting. Without it, the same clone can store different bytes on
# a desktop and a laptop, which shows up later as whole-file diffs that contain
# no real change.

# Detect text files and store them with LF inside the repository. Checkouts
# still get the platform's native endings, so Windows editors behave normally.
* text=auto

# These run inside Linux containers, where a CR would be read as part of the
# command, so they keep LF on every platform.
*.sh text eol=lf
docker/initdb/*.sql text eol=lf

# PowerShell is a Windows tool and stays CRLF.
*.ps1 text eol=crlf
