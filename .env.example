# REQUIRED. OpenAI serves the answer model and the evaluation judge, and is the
# only value you have to supply. Everything below already works as it stands.
OPENAI_API_KEY=

# OPTIONAL. Logfire takes a write token for telemetry and a read token for
# querying it back. Left empty, the app runs and sends nothing; filled in, it
# sends to your own Logfire project and the monitoring views fill up. Only the
# write token is read by the application: the charts are drawn in Logfire over
# the spans already sent, and the read token is for querying the project from
# outside it, such as through Logfire's MCP server. Neither is named
# LOGFIRE_TOKEN, so Logfire cannot pick one up implicitly and every caller has to
# pass what it needs.
LOGFIRE_WRITE_TOKEN=
LOGFIRE_READ_TOKEN=

# Docker Compose provisions PostgreSQL from these values. The container always
# listens on 5432; POSTGRES_HOST_PORT is only the port published on the host,
# kept off 5432 because other projects on this machine use it. POSTGRES_HOST is
# where client code connects and is spelled out rather than assumed. The password
# is a local-only default; the database listens on the loopback and holds public
# Wikipedia text.
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=supernatural
POSTGRES_PASSWORD=wendigo
POSTGRES_DB=supernatural
POSTGRES_HOST_PORT=5434

# Where the chat is published on the host. The container always listens on 8501,
# and this only moves the door. The app container overrides POSTGRES_HOST and
# POSTGRES_HOST_PORT for itself, because a service on the Compose network is not
# reached the way a host reaches it; see docker/container.env.
STREAMLIT_HOST_PORT=8501

# Wikimedia asks for a descriptive User-Agent that identifies the software and a
# way to reach whoever is running it. This is filled in so the project runs
# straight from a fresh copy; the address is the maintainer's and is already
# public in pyproject.toml. Anyone running this at volume should put their own
# contact here instead.
WIKIPEDIA_USER_AGENT=supernatural-expert/0.1 (https://github.com/joan-pareja/supernatural-expert; jparegar9@gmail.com)
