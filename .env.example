# OpenAI serves the answer model and the evaluation judge.
OPENAI_API_KEY=

# Logfire needs a write token for telemetry and a read token for the reporting
# page's Query API calls. The write token is deliberately not named
# LOGFIRE_TOKEN, so Logfire cannot pick it up implicitly and every caller has to
# pass it.
LOGFIRE_WRITE_TOKEN=
LOGFIRE_READ_TOKEN=

# Docker Compose provisions PostgreSQL from these values. The container always
# listens on 5432; POSTGRES_HOST_PORT is only the port published on the host,
# kept off 5432 because other projects on this machine use it. The password is a
# local-only default; the database listens on the loopback and holds public
# Wikipedia text.
POSTGRES_USER=supernatural
POSTGRES_PASSWORD=wendigo
POSTGRES_DB=supernatural
POSTGRES_HOST_PORT=5434

# Wikimedia asks for a descriptive User-Agent that identifies the project and a
# way to contact its maintainer.
WIKIPEDIA_USER_AGENT=supernatural-expert/0.1 (https://github.com/OWNER/supernatural-expert; EMAIL)
